{
  "name": "jiwon4u-content-studio",
  "version": "0.1.0",
  "private": true,
  "description": "지원포유 블로그 원고 생성·자동 포스팅·카드뉴스·분석 대시보드",
  "scripts": {
    "dev": "concurrently -n web,worker -c blue,magenta \"next dev\" \"npm run worker\"",
    "dev:web": "next dev",
    "build": "next build",
    "start": "concurrently -n web,worker \"next start\" \"npm run worker\"",
    "worker": "tsx scripts/worker.ts",
    "naver:login": "tsx scripts/naver-login.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "prisma db push && tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:concepts": "tsx scripts/check-concepts.ts",
    "check:ai": "tsx scripts/check-ai.ts",
    "naver:check": "tsx scripts/naver-check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@google/genai": "^2.24.0",
    "@prisma/client": "^6.19.3",
    "croner": "^10.0.1",
    "googleapis": "^182.0.0",
    "jszip": "^3.10.2",
    "marked": "^18.0.14",
    "next": "^16.3.6",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
