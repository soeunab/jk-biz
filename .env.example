# ─────────────────────────────────────────────────────────────
# 지원포유 콘텐츠 스튜디오 환경변수
# 키가 비어 있는 기능은 건너뛰거나 무료 대안(스톡 이미지·템플릿·수동 입력)으로 동작합니다.
# AI 는 API 키 없이 Claude 구독(Claude Code)으로 추가 요금 없이 운영해요 (Claude Code 가 없으면 수동 모드).
# ─────────────────────────────────────────────────────────────

# DB (개발은 SQLite, 운영은 postgresql://... 권장)
DATABASE_URL="file:./dev.db"

# 대시보드 접속 비밀번호 (Basic Auth, 아이디는 아무거나). 비우면 인증 없음 — 로컬 전용일 때만 비우세요.
DASHBOARD_PASSWORD=""

# 인증정보 암호화 키 (32자 이상 임의 문자열). 한 번 정하면 바꾸지 마세요.
APP_SECRET="change-me-to-a-long-random-string-32chars+"

# 외부에서 이미지에 접근 가능한 주소 (블로거·인스타 발행 시 이미지 URL 로 사용)
PUBLIC_BASE_URL="http://localhost:3000"

# ── 글쓰기 AI ───────────────────────────────────────────────
# 공급자: claude-code | ollama | manual | anthropic | gemini | mock
#   claude-code : 맥에 설치된 Claude Code 를 "구독 로그인"으로 실행 → API 요금 없음 (구독 사용 한도 사용)
#   ollama      : 로컬 LLM (무료·무제한) — 짧은 작업용. 웹 검색 불가
#   manual      : 지시문을 복사해 데스크탑 Claude 에 붙여 넣고 결과를 붙여 넣기 (/manual 수동 작업함)
#   anthropic / gemini : API 키 방식 — 사용량만큼 별도 과금 (구독과 별개)
#   mock        : 데모용 샘플
# 작업별 담당 (비우면 자동: Claude Code 설치됨 → 모든 작업 claude-code, 없으면 manual. 로컬 Ollama 는 직접 지정할 때만)
LLM_WRITE=""       # 원고·섹션 다시 쓰기·AI 사실 검수
LLM_RESEARCH=""    # 최신 정보 조사(웹 검색) — ollama 는 검색이 안 돼 조사를 건너뜀
LLM_LIGHT=""       # 주제 기획 문구·카드뉴스·발전 제안 요약
# 담당 AI 가 실패(구독 한도 초과·미설치·오프라인)하면 넘길 곳. 기본 manual, 끄려면 none
LLM_FALLBACK=""
# 세 작업을 한 번에 지정 (위 LLM_WRITE 등이 우선)
LLM_PROVIDER=""

# Claude Code (구독) — 설치: https://claude.com/claude-code → 터미널에서 claude 실행 → /login (Pro/Max 구독 계정)
# 이 프로그램은 Claude Code 를 실행할 때 ANTHROPIC_API_KEY 등을 자동으로 빼서, 키가 있어도 구독으로만 동작합니다.
CLAUDE_CODE_BIN=""            # claude 경로를 못 찾을 때만 (예: /opt/homebrew/bin/claude)
CLAUDE_CODE_MODEL="sonnet"    # sonnet | opus (opus 는 구독 한도를 더 빨리 씀)
CLAUDE_CODE_JSON_SCHEMA=""    # 구버전 Claude Code 에서 --json-schema 오류가 나면 0

# Ollama (로컬) — https://ollama.com 설치 후: ollama pull gemma4:12b
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="gemma4:12b"
OLLAMA_NUM_CTX="16384"        # 24GB 메모리 기준 권장. 느리면 8192

# API 키 방식 (선택 — 넣으면 자동 선택 순서에서 Claude Code 다음 후보가 되고, 사용량만큼 과금)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"
GEMINI_API_KEY=""
GEMINI_TEXT_MODEL="gemini-2.5-pro"
# 이미지 생성 모델 (Gemini 이미지 모델명은 수시로 바뀌니 Google AI Studio 에서 확인)
GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"

# ── 이미지 검색 ──────────────────────────────────────────────
UNSPLASH_ACCESS_KEY=""
PEXELS_API_KEY=""

# 이미지 외부 호스팅 (gcs | local | cloudinary). 블로거는 API 로 이미지 업로드가 불가해 공개 URL 이 필요합니다.
# gcs: 구글 클라우드 스토리지 — 전용 버킷·서비스 계정 키 필요(README 참고), 새 계정 불필요
IMAGE_HOST="local"
GCS_BUCKET=""
GCS_KEY_FILE=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── 주제 발굴 (네이버) ────────────────────────────────────────
# 네이버 검색(블로그 문서수)·데이터랩(검색어트렌드): 2026-07-31부로 개발자센터 신규 발급 종료, NAVER API HUB(NCP)로 이전됨.
# console.ncloud.com 로그인(카드 등록 필요, 무료 등급 일 25,000건) → NAVER API HUB → Application 등록 → Client ID/Secret
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""
# 네이버 검색광고 API (월간 검색량·경쟁도): https://searchad.naver.com → 도구 → API 사용관리
NAVER_AD_API_KEY=""
NAVER_AD_SECRET_KEY=""
NAVER_AD_CUSTOMER_ID=""

# ── 구글 OAuth (블로거 발행 · GA4 · 서치콘솔 · 애드센스) ───────
# Google Cloud Console → OAuth 클라이언트(웹 애플리케이션)
# 승인된 리디렉션 URI: {PUBLIC_BASE_URL}/api/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── 네이버 블로그 자동화 (Playwright) ─────────────────────────
# 1 이면 브라우저 창을 띄워 진행 상황을 볼 수 있습니다.
NAVER_HEADFUL="0"

# ── SNS (Meta Graph API: 인스타그램·스레드) ───────────────────
META_GRAPH_VERSION="v21.0"

# ── 스케줄러 (워커) — cron 표현식, 비우면 비활성 ──────────────
CRON_TOPIC_DISCOVERY="0 7 * * 1"
# 실시간 6채널(네이버 홈판·랭킹·네이트·구글 트렌드·다음·구글 뉴스) 발굴 — 예: 매일 오전 7시 50분 "50 7 * * *"
CRON_CHANNEL_DISCOVERY=""
# 예약 실행 때 쓸 네이버 블로그 카테고리 (예: 비즈니스·경제, IT·컴퓨터). 비우면 "주제 선택 보류"(전체)
CHANNEL_DISCOVERY_CATEGORY=""
CRON_ANALYTICS_SYNC="30 6 * * *"
CRON_INSIGHTS="0 8 * * *"
# 네이버 계정별 홈판형 글 목표 비율(0~1) — 실무자 경험칙 "홈판 7 : 검색 3" 기본, 발전 제안에서 차이가 크면 알림
NAVER_HOMEFEED_RATIO="0.7"
# 보류(DISMISSED) 상태로 7일 지난 주제 자동 삭제 — 예: 매일 새벽 5시
CRON_TOPIC_CLEANUP="0 5 * * *"
# 황금키워드 발굴(시드 없이 업종 키워드 → 검색량 구간별 비율 순) — 매일 새벽 3시. 비우면 버튼으로만
CRON_GOLDEN_DISCOVERY="0 3 * * *"
# 황금키워드 1회 실행의 문서수 측정 예산 — 블로그 섹션 검색 화면 조회(공식 API 한도 안 씀, 초당 2회, 약 10분 조각으로 나눠 실행)
GOLDEN_SECTION_BUDGET="10000"
# 화면 상한(1000)에 걸린 큰 키워드(검색량 1만 이상)만 공식 API 로 확인하는 실행당 상한 (공식 API 는 월 24,950회 한도)
GOLDEN_API_BUDGET="100"

# (선택) Playwright 대신 이미 설치된 크롬/크로미움 경로 사용
# 예) Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
CHROMIUM_EXECUTABLE_PATH=""
