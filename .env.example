# ─────────────────────────────────────────────────────────────
# 지원포유 콘텐츠 스튜디오 환경변수
# 키가 비어 있는 기능은 자동으로 "데모(mock) 모드"로 동작합니다.
# ─────────────────────────────────────────────────────────────

# DB (개발은 SQLite, 운영은 postgresql://... 권장)
DATABASE_URL="file:./dev.db"

# 대시보드 접속 비밀번호 (Basic Auth, 아이디는 아무거나). 비우면 인증 없음 — 로컬 전용일 때만 비우세요.
DASHBOARD_PASSWORD=""

# 인증정보 암호화 키 (32자 이상 임의 문자열). 한 번 정하면 바꾸지 마세요.
APP_SECRET="change-me-to-a-long-random-string-32chars+"

# 외부에서 이미지에 접근 가능한 주소 (블로거·인스타 발행 시 이미지 URL 로 사용)
PUBLIC_BASE_URL="http://localhost:3000"

# ── 글쓰기 AI ───────────────────────────────────────────────
# anthropic | gemini | mock  (비우면 키가 있는 쪽 자동 선택)
LLM_PROVIDER=""
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"
GEMINI_API_KEY=""
GEMINI_TEXT_MODEL="gemini-2.5-pro"
# 이미지 생성 모델 (Gemini 이미지 모델명은 수시로 바뀌니 Google AI Studio 에서 확인)
GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"

# ── 이미지 검색 ──────────────────────────────────────────────
UNSPLASH_ACCESS_KEY=""
PEXELS_API_KEY=""

# 이미지 외부 호스팅 (local | cloudinary). 블로거는 API 로 이미지 업로드가 불가해 공개 URL 이 필요합니다.
IMAGE_HOST="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── 주제 발굴 (네이버) ────────────────────────────────────────
# 네이버 개발자센터(검색·데이터랩): https://developers.naver.com
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""
# 네이버 검색광고 API (월간 검색량·경쟁도): https://searchad.naver.com → 도구 → API 사용관리
NAVER_AD_API_KEY=""
NAVER_AD_SECRET_KEY=""
NAVER_AD_CUSTOMER_ID=""

# ── 구글 OAuth (블로거 발행 · GA4 · 서치콘솔 · 애드센스) ───────
# Google Cloud Console → OAuth 클라이언트(웹 애플리케이션)
# 승인된 리디렉션 URI: {PUBLIC_BASE_URL}/api/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── 네이버 블로그 자동화 (Playwright) ─────────────────────────
# 1 이면 브라우저 창을 띄워 진행 상황을 볼 수 있습니다.
NAVER_HEADFUL="0"

# ── SNS (Meta Graph API: 인스타그램·스레드) ───────────────────
META_GRAPH_VERSION="v21.0"

# ── 스케줄러 (워커) — cron 표현식, 비우면 비활성 ──────────────
CRON_TOPIC_DISCOVERY="0 7 * * 1"
CRON_ANALYTICS_SYNC="30 6 * * *"
CRON_INSIGHTS="0 8 * * *"

# (선택) Playwright 대신 이미 설치된 크롬/크로미움 경로 사용
# 예) Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
CHROMIUM_EXECUTABLE_PATH=""
